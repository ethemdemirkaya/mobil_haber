a:2:{s:7:"expires";i:1778169907;s:5:"value";a:29:{i:0;a:13:{s:2:"id";s:45:"rss-aa-genel-bd9a95dcbe8b11d62cbfe7f8936cdb0a";s:5:"title";s:47:"Baykar, SAHA 2026'da birçok anlaşma imzaladı";s:7:"summary";s:131:"Baykar'ın anlaşma imzaladığı şirketler arasında MKE, Aksa İleri Kompozit, TEI, ASELSAN, ROKETSAN ve EDGE Group yer alıyor.";s:7:"content";s:131:"Baykar'ın anlaşma imzaladığı şirketler arasında MKE, Aksa İleri Kompozit, TEI, ASELSAN, ROKETSAN ve EDGE Group yer alıyor.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:43:"https://picsum.photos/seed/3930297/1200/800";s:6:"author";s:15:"Anadolu Ajansı";s:11:"publishedAt";s:25:"2026-05-07T14:07:37+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:12:"rss-aa-genel";s:10:"sourceName";s:15:"Anadolu Ajansı";s:9:"sourceUrl";s:91:"https://www.aa.com.tr/tr/bilim-teknoloji/baykar-saha-2026da-bircok-anlasma-imzaladi/3930297";}i:1;a:13:{s:2:"id";s:45:"rss-aa-genel-2d02c35b7298b06690550e804dac519e";s:5:"title";s:121:"Uzmanlara göre İran ile ABD arasındaki müzakereler tarafların tavizsiz yaklaşımıyla "teknik düzeye" ulaşamıyor";s:7:"summary";s:233:"İran ile ABD arasında, savaşın sonlandırılması hedefine yönelik gerçekleştirilen görüşmeler yürütülürken, uzmanlar iki tarafın "tavizsiz yaklaşımı" sebebiyle müzakerelerin "teknik düzeye inemediği" belirtiyor.";s:7:"content";s:233:"İran ile ABD arasında, savaşın sonlandırılması hedefine yönelik gerçekleştirilen görüşmeler yürütülürken, uzmanlar iki tarafın "tavizsiz yaklaşımı" sebebiyle müzakerelerin "teknik düzeye inemediği" belirtiyor.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:43:"https://picsum.photos/seed/3930408/1200/800";s:6:"author";s:15:"Anadolu Ajansı";s:11:"publishedAt";s:25:"2026-05-07T15:48:29+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:12:"rss-aa-genel";s:10:"sourceName";s:15:"Anadolu Ajansı";s:9:"sourceUrl";s:147:"https://www.aa.com.tr/tr/dunya/uzmanlara-gore-iran-ile-abd-arasindaki-muzakereler-taraflarin-tavizsiz-yaklasimiyla-teknik-duzeye-ulasamiyor/3930408";}i:2;a:13:{s:2:"id";s:45:"rss-aa-genel-35dd1f081c8a2073e1425ff788fbbcd9";s:5:"title";s:91:"BM: Sudan'daki savaş ve Güney Sudan'daki istikrarsızlık Abyei'deki ilerlemeyi etkiliyor";s:7:"summary";s:183:"Birleşmiş Milletler (BM), Sudan'daki çatışma ve Güney Sudan'daki istikrarsızlığın Abyei'deki siyasi durumu ve nihai statüsü konusundaki ilerlemeyi etkilendiğini belirtti.";s:7:"content";s:183:"Birleşmiş Milletler (BM), Sudan'daki çatışma ve Güney Sudan'daki istikrarsızlığın Abyei'deki siyasi durumu ve nihai statüsü konusundaki ilerlemeyi etkilendiğini belirtti.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:43:"https://picsum.photos/seed/3930406/1200/800";s:6:"author";s:15:"Anadolu Ajansı";s:11:"publishedAt";s:25:"2026-05-07T15:44:46+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:12:"rss-aa-genel";s:10:"sourceName";s:15:"Anadolu Ajansı";s:9:"sourceUrl";s:122:"https://www.aa.com.tr/tr/dunya/bm-sudandaki-savas-ve-guney-sudandaki-istikrarsizlik-abyeideki-ilerlemeyi-etkiliyor/3930406";}i:3;a:13:{s:2:"id";s:45:"rss-aa-genel-30c2e16f26030e0bc734fecc4dcf56c9";s:5:"title";s:70:"SAHA 2026'da milli teknolojilerin teslim törenleri gerçekleştirildi";s:7:"summary";s:261:"Teslim törenleri yapılan teknolojiler arasında Türkiye'nin ilk yerli bulut sanallaştırma ürünü olan TSK Bulut Bilişim Sistemi Projesi, Türkiye'nin ilk yerli yedekleme yazılımı ürünü ve Türkiye'nin ilk uç nokta güvenlik platformu yer alıyor.";s:7:"content";s:261:"Teslim törenleri yapılan teknolojiler arasında Türkiye'nin ilk yerli bulut sanallaştırma ürünü olan TSK Bulut Bilişim Sistemi Projesi, Türkiye'nin ilk yerli yedekleme yazılımı ürünü ve Türkiye'nin ilk uç nokta güvenlik platformu yer alıyor.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:43:"https://picsum.photos/seed/3930349/1200/800";s:6:"author";s:15:"Anadolu Ajansı";s:11:"publishedAt";s:25:"2026-05-07T14:51:20+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:12:"rss-aa-genel";s:10:"sourceName";s:15:"Anadolu Ajansı";s:9:"sourceUrl";s:115:"https://www.aa.com.tr/tr/bilim-teknoloji/saha-2026da-milli-teknolojilerin-teslim-torenleri-gerceklestirildi/3930349";}i:4;a:13:{s:2:"id";s:45:"rss-aa-genel-e0e4bff7f0c67ce95092c08a732df3ba";s:5:"title";s:43:"CANLI - Cumhurbaşkanı Erdoğan konuşuyor";s:7:"summary";s:126:"Cumhurbaşkanı Recep Tayyip Erdoğan, Cezayir Cumhurbaşkanı Abdülmecid Tebbun ile ortak basın toplantısında konuşuyor.";s:7:"content";s:126:"Cumhurbaşkanı Recep Tayyip Erdoğan, Cezayir Cumhurbaşkanı Abdülmecid Tebbun ile ortak basın toplantısında konuşuyor.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:43:"https://picsum.photos/seed/3930220/1200/800";s:6:"author";s:15:"Anadolu Ajansı";s:11:"publishedAt";s:25:"2026-05-07T13:10:40+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:12:"rss-aa-genel";s:10:"sourceName";s:15:"Anadolu Ajansı";s:9:"sourceUrl";s:77:"https://www.aa.com.tr/tr/gundem/canli-cumhurbaskani-erdogan-konusuyor/3930220";}i:5;a:13:{s:2:"id";s:45:"rss-aa-genel-999c1327e1aa33b75c308567d74bcef8";s:5:"title";s:39:"Borsa günü rekor seviyeden tamamladı";s:7:"summary";s:117:"Borsa İstanbul'da BIST 100 endeksi, günü yüzde 0,82 değer kazanarak 15.040,25 puanla rekor seviyeden tamamladı.";s:7:"content";s:117:"Borsa İstanbul'da BIST 100 endeksi, günü yüzde 0,82 değer kazanarak 15.040,25 puanla rekor seviyeden tamamladı.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:43:"https://picsum.photos/seed/3930398/1200/800";s:6:"author";s:15:"Anadolu Ajansı";s:11:"publishedAt";s:25:"2026-05-07T15:34:11+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:12:"rss-aa-genel";s:10:"sourceName";s:15:"Anadolu Ajansı";s:9:"sourceUrl";s:77:"https://www.aa.com.tr/tr/ekonomi/borsa-gunu-rekor-seviyeden-tamamladi/3930398";}i:6;a:13:{s:2:"id";s:45:"rss-aa-genel-c6f3b0acfab2d2abfebff5ef6e6dd54a";s:5:"title";s:67:"Yerli endüstriyel robotlar SR40 ve SR80, SAHA 2026'da sergileniyor";s:7:"summary";s:179:"Milli endüstriyel robotlar, geniş çalışma uzayı, yüksek tekrarlanabilirlik hassasiyeti, optimize edilmiş hareket kontrol mimarisi ile küresel standartları karşılıyor.";s:7:"content";s:179:"Milli endüstriyel robotlar, geniş çalışma uzayı, yüksek tekrarlanabilirlik hassasiyeti, optimize edilmiş hareket kontrol mimarisi ile küresel standartları karşılıyor.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:43:"https://picsum.photos/seed/3930391/1200/800";s:6:"author";s:15:"Anadolu Ajansı";s:11:"publishedAt";s:25:"2026-05-07T15:28:32+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:12:"rss-aa-genel";s:10:"sourceName";s:15:"Anadolu Ajansı";s:9:"sourceUrl";s:113:"https://www.aa.com.tr/tr/bilim-teknoloji/yerli-endustriyel-robotlar-sr40-ve-sr80-saha-2026da-sergileniyor/3930391";}i:7;a:13:{s:2:"id";s:45:"rss-aa-genel-8f36fed951a2a7a6878f1b3831a5e07b";s:5:"title";s:109:"Bulgaristan'da hükümeti kurmakla görevlendirilen Radev, bakanlar kurulu listesini Cumhurbaşkanı'na sundu";s:7:"summary";s:233:"Bulgaristan'da 19 Nisan'da yapılan genel seçimlerde en yüksek oyu alan ve hükümeti kurmakla görevlendirilen İlerici Bulgaristan Koalisyonu lideri Rumen Radev, bakanlar kurulu listesini Cumhurbaşkanı İliyana Yotova'ya sundu.";s:7:"content";s:233:"Bulgaristan'da 19 Nisan'da yapılan genel seçimlerde en yüksek oyu alan ve hükümeti kurmakla görevlendirilen İlerici Bulgaristan Koalisyonu lideri Rumen Radev, bakanlar kurulu listesini Cumhurbaşkanı İliyana Yotova'ya sundu.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:43:"https://picsum.photos/seed/3930376/1200/800";s:6:"author";s:15:"Anadolu Ajansı";s:11:"publishedAt";s:25:"2026-05-07T15:10:37+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:12:"rss-aa-genel";s:10:"sourceName";s:15:"Anadolu Ajansı";s:9:"sourceUrl";s:140:"https://www.aa.com.tr/tr/dunya/bulgaristanda-hukumeti-kurmakla-gorevlendirilen-radev-bakanlar-kurulu-listesini-cumhurbaskanina-sundu/3930376";}i:8;a:13:{s:2:"id";s:45:"rss-aa-genel-9cb12ac2d62f5475c6b9c2ab196c6902";s:5:"title";s:70:"Beynin bilinç kapalıyken de öğrenmeyi sürdürebildiği belirlendi";s:7:"summary";s:155:"ABD'de yapılan araştırma, beynin genel anestezi altında bile duyduğu kelimeleri anlamlandırmaya ve dil öğrenmeye devam edebileceğini ortaya koydu.";s:7:"content";s:155:"ABD'de yapılan araştırma, beynin genel anestezi altında bile duyduğu kelimeleri anlamlandırmaya ve dil öğrenmeye devam edebileceğini ortaya koydu.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:43:"https://picsum.photos/seed/3930387/1200/800";s:6:"author";s:15:"Anadolu Ajansı";s:11:"publishedAt";s:25:"2026-05-07T15:25:54+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:12:"rss-aa-genel";s:10:"sourceName";s:15:"Anadolu Ajansı";s:9:"sourceUrl";s:112:"https://www.aa.com.tr/tr/bilim-teknoloji/beynin-bilinc-kapaliyken-de-ogrenmeyi-surdurebildigi-belirlendi/3930387";}i:9;a:13:{s:2:"id";s:45:"rss-aa-genel-0f6fca6746df7e0948ba1ff0c40ee811";s:5:"title";s:121:"Bakan Güler: AR-GE Merkezince geliştirilen savunma sanayisi ürünlerinde temel hedef dışa bağımlılığı azaltmak";s:7:"summary";s:256:"Milli Savunma Bakanı Yaşar Güler, Bakanlığın AR-GE Merkezince geliştirilen savunma sanayisi ürünlerine ilişkin, "Buradaki temel hedef, kritik teknolojilerde dışa bağımlılığı azaltmak, savunma sanayisi firmalarına öncülük etmek." dedi.";s:7:"content";s:256:"Milli Savunma Bakanı Yaşar Güler, Bakanlığın AR-GE Merkezince geliştirilen savunma sanayisi ürünlerine ilişkin, "Buradaki temel hedef, kritik teknolojilerde dışa bağımlılığı azaltmak, savunma sanayisi firmalarına öncülük etmek." dedi.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:43:"https://picsum.photos/seed/3930235/1200/800";s:6:"author";s:15:"Anadolu Ajansı";s:11:"publishedAt";s:25:"2026-05-07T13:19:29+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:12:"rss-aa-genel";s:10:"sourceName";s:15:"Anadolu Ajansı";s:9:"sourceUrl";s:157:"https://www.aa.com.tr/tr/bilim-teknoloji/bakan-guler-ar-ge-merkezince-gelistirilen-savunma-sanayisi-urunlerinde-temel-hedef-disa-bagimliligi-azaltmak/3930235";}i:10;a:13:{s:2:"id";s:45:"rss-aa-genel-a86564db5ab1e19006d04353db534bf6";s:5:"title";s:78:"EFES-2026 Tatbikatı'nın Mayın Avlama Harekatı İzmir'de gerçekleştirildi";s:7:"summary";s:145:"Türk Silahlı Kuvvetlerinin (TSK) EFES-2026 Tatbikatı kapsamında İzmir'de düzenlenen Mayın Avlama Harekatı'nda denizde mayın imha edildi.";s:7:"content";s:145:"Türk Silahlı Kuvvetlerinin (TSK) EFES-2026 Tatbikatı kapsamında İzmir'de düzenlenen Mayın Avlama Harekatı'nda denizde mayın imha edildi.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:43:"https://picsum.photos/seed/3930382/1200/800";s:6:"author";s:15:"Anadolu Ajansı";s:11:"publishedAt";s:25:"2026-05-07T15:22:25+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:12:"rss-aa-genel";s:10:"sourceName";s:15:"Anadolu Ajansı";s:9:"sourceUrl";s:109:"https://www.aa.com.tr/tr/gundem/efes-2026-tatbikatinin-mayin-avlama-harekati-izmirde-gerceklestirildi/3930382";}i:11;a:13:{s:2:"id";s:45:"rss-aa-genel-d537dee43c2830b70c8152c492737fbc";s:5:"title";s:71:"İstanbul'da akşam saatlerinde trafik yoğunluğu yüzde 78'e çıktı";s:7:"summary";s:125:"İstanbul'da akşam saatlerinde etkisini artıran trafik yoğunluğu nedeniyle ana arterlerde araçlar güçlükle ilerliyor.";s:7:"content";s:125:"İstanbul'da akşam saatlerinde etkisini artıran trafik yoğunluğu nedeniyle ana arterlerde araçlar güçlükle ilerliyor.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:43:"https://picsum.photos/seed/3930384/1200/800";s:6:"author";s:15:"Anadolu Ajansı";s:11:"publishedAt";s:25:"2026-05-07T15:23:00+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:12:"rss-aa-genel";s:10:"sourceName";s:15:"Anadolu Ajansı";s:9:"sourceUrl";s:101:"https://www.aa.com.tr/tr/gundem/istanbulda-aksam-saatlerinde-trafik-yogunlugu-yuzde-78e-cikti/3930384";}i:12;a:13:{s:2:"id";s:45:"rss-aa-genel-4ea9d8b2edb38c208a1c2d824f4c8b56";s:5:"title";s:86:"Gazze'de, okul sırasında olması gereken çocuklar saatlerce su kuyruğunda bekliyor";s:7:"summary";s:252:"İsrail’in saldırıları ve ağır şartlar altında yaşam mücadelesi veren Gazze Şeridi’ndeki çocuklar, okulda ders sıralarında olmaları gerekirken ailelerine bir bidon su götürebilmek için her gün saatlerce su kuyruklarında bekliyor.";s:7:"content";s:252:"İsrail’in saldırıları ve ağır şartlar altında yaşam mücadelesi veren Gazze Şeridi’ndeki çocuklar, okulda ders sıralarında olmaları gerekirken ailelerine bir bidon su götürebilmek için her gün saatlerce su kuyruklarında bekliyor.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:43:"https://picsum.photos/seed/3930305/1200/800";s:6:"author";s:15:"Anadolu Ajansı";s:11:"publishedAt";s:25:"2026-05-07T14:10:41+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:12:"rss-aa-genel";s:10:"sourceName";s:15:"Anadolu Ajansı";s:9:"sourceUrl";s:118:"https://www.aa.com.tr/tr/dunya/gazzede-okul-sirasinda-olmasi-gereken-cocuklar-saatlerce-su-kuyrugunda-bekliyor/3930305";}i:13;a:13:{s:2:"id";s:45:"rss-aa-genel-829ec383f963844b047218cc8b2304c7";s:5:"title";s:105:"İsrail ordusu Batı Şeria’da tarım tesislerini tahrip etti, Beytüllahim’de kontrol noktası kurdu";s:7:"summary";s:191:"İsrail ordusunun, işgal altındaki Batı Şeria’nın çeşitli bölgelerinde tarım tesislerine zarar verdiği ve Beytüllahim’in doğusunda askeri kontrol noktası kurduğu bildirildi.";s:7:"content";s:191:"İsrail ordusunun, işgal altındaki Batı Şeria’nın çeşitli bölgelerinde tarım tesislerine zarar verdiği ve Beytüllahim’in doğusunda askeri kontrol noktası kurduğu bildirildi.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:43:"https://picsum.photos/seed/3930360/1200/800";s:6:"author";s:15:"Anadolu Ajansı";s:11:"publishedAt";s:25:"2026-05-07T14:59:58+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:12:"rss-aa-genel";s:10:"sourceName";s:15:"Anadolu Ajansı";s:9:"sourceUrl";s:133:"https://www.aa.com.tr/tr/dunya/israil-ordusu-bati-seria-da-tarim-tesislerini-tahrip-etti-beytullahim-de-kontrol-noktasi-kurdu/3930360";}i:14;a:13:{s:2:"id";s:45:"rss-aa-genel-033912c0bc0e7c30f68d361d230e7970";s:5:"title";s:70:"Doğu-Batı Dostluk ve İpek Yolu Rallisi Kapadokya etabı tamamlandı";s:7:"summary";s:124:"Almanya'da başlayan ve Nepal'de sonlanacak olan Doğu-Batı Dostluk ve İpek Yolu Rallisi'nin Kapadokya etabı tamamlandı.";s:7:"content";s:124:"Almanya'da başlayan ve Nepal'de sonlanacak olan Doğu-Batı Dostluk ve İpek Yolu Rallisi'nin Kapadokya etabı tamamlandı.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:43:"https://picsum.photos/seed/3927386/1200/800";s:6:"author";s:15:"Anadolu Ajansı";s:11:"publishedAt";s:25:"2026-05-05T08:04:06+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:12:"rss-aa-genel";s:10:"sourceName";s:15:"Anadolu Ajansı";s:9:"sourceUrl";s:103:"https://www.aa.com.tr/tr/spor/dogu-bati-dostluk-ve-ipek-yolu-rallisi-kapadokya-etabi-tamamlandi/3927386";}i:15;a:13:{s:2:"id";s:45:"rss-aa-genel-ced4909c53b4d2b2593214eb39410b21";s:5:"title";s:74:"Somali'de 6,5 milyon kişi ciddi gıda güvensizliğiyle karşı karşıya";s:7:"summary";s:270:"Birleşmiş Milletler'in (BM) Somali İnsani Koordinatörü George Conway, ülkede kuraklık nedeniyle açlık ve yetersiz beslenme krizinin giderek derinleştiğini belirterek, yaklaşık 6,5 milyon kişinin şiddetli açlıkla karşı karşıya kalacağını bildirdi.";s:7:"content";s:270:"Birleşmiş Milletler'in (BM) Somali İnsani Koordinatörü George Conway, ülkede kuraklık nedeniyle açlık ve yetersiz beslenme krizinin giderek derinleştiğini belirterek, yaklaşık 6,5 milyon kişinin şiddetli açlıkla karşı karşıya kalacağını bildirdi.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:43:"https://picsum.photos/seed/3930350/1200/800";s:6:"author";s:15:"Anadolu Ajansı";s:11:"publishedAt";s:25:"2026-05-07T14:52:14+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:12:"rss-aa-genel";s:10:"sourceName";s:15:"Anadolu Ajansı";s:9:"sourceUrl";s:104:"https://www.aa.com.tr/tr/dunya/somalide-6-5-milyon-kisi-ciddi-gida-guvensizligiyle-karsi-karsiya/3930350";}i:16;a:13:{s:2:"id";s:45:"rss-aa-genel-b314c85e187d7b3bfaacaf06916cac33";s:5:"title";s:53:"CHP Genel Başkanı Özel, SAHA 2026'yı ziyaret etti";s:7:"summary";s:258:"CHP Genel Başkanı Özgür Özel, SAHA 2026'ya ilişkin, "Burada kim ne emek veriyorsa, ama sermaye olarak ama sabahlara kadar çalışarak, gözünün nurunu akıtarak, dirsek çürüterek savunma sanayi için kim ne yapıyorsa hepsine minnettarız." dedi.";s:7:"content";s:258:"CHP Genel Başkanı Özgür Özel, SAHA 2026'ya ilişkin, "Burada kim ne emek veriyorsa, ama sermaye olarak ama sabahlara kadar çalışarak, gözünün nurunu akıtarak, dirsek çürüterek savunma sanayi için kim ne yapıyorsa hepsine minnettarız." dedi.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:43:"https://picsum.photos/seed/3930289/1200/800";s:6:"author";s:15:"Anadolu Ajansı";s:11:"publishedAt";s:25:"2026-05-07T14:02:33+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:12:"rss-aa-genel";s:10:"sourceName";s:15:"Anadolu Ajansı";s:9:"sourceUrl";s:87:"https://www.aa.com.tr/tr/gundem/chp-genel-baskani-ozel-saha-2026yi-ziyaret-etti/3930289";}i:17;a:13:{s:2:"id";s:45:"rss-aa-genel-924798e3169aa5be74d323c8dc83b7ff";s:5:"title";s:105:"DSÖ, bir yolcu gemisinde bildirilen 8 vakadan 5'inin hantavirüs olduğunun doğrulandığını belirtti";s:7:"summary";s:237:"Dünya Sağlık Örgütü (DSÖ) Genel Direktörü Tedros Adhanom Ghebreyesus, Arjantin'den yola çıkan bir gemide bildirilen 8 vakadan 5'inin hantavirüs olduğunun doğrulandığını, diğer 3'ünde ise şüphe bulunduğunu belirtti.";s:7:"content";s:237:"Dünya Sağlık Örgütü (DSÖ) Genel Direktörü Tedros Adhanom Ghebreyesus, Arjantin'den yola çıkan bir gemide bildirilen 8 vakadan 5'inin hantavirüs olduğunun doğrulandığını, diğer 3'ünde ise şüphe bulunduğunu belirtti.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:43:"https://picsum.photos/seed/3930344/1200/800";s:6:"author";s:15:"Anadolu Ajansı";s:11:"publishedAt";s:25:"2026-05-07T14:44:02+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:12:"rss-aa-genel";s:10:"sourceName";s:15:"Anadolu Ajansı";s:9:"sourceUrl";s:134:"https://www.aa.com.tr/tr/dunya/dso-bir-yolcu-gemisinde-bildirilen-8-vakadan-5inin-hantavirus-oldugunun-dogrulandigini-belirtti/3930344";}i:18;a:13:{s:2:"id";s:45:"rss-aa-genel-6033309578737de8a864bc1f0f9dd9be";s:5:"title";s:139:"Cumhurbaşkanı Yardımcısı Yılmaz: Kamuda bulut bilişim ve yapay zeka kullanımında yatırımlarının hızlanmasını öngörüyoruz";s:7:"summary";s:267:"Cevdet Yılmaz, "Kamuda bulut bilişim ve yapay zeka kullanımını yaygınlaştırmak üzere gerekli teknik altyapı, hukuki çerçeve ve idari mekanizmaları tesis ederek kamu kaynaklı taleple özel sektör yatırımlarının hızlanmasını öngörüyoruz." dedi.";s:7:"content";s:267:"Cevdet Yılmaz, "Kamuda bulut bilişim ve yapay zeka kullanımını yaygınlaştırmak üzere gerekli teknik altyapı, hukuki çerçeve ve idari mekanizmaları tesis ederek kamu kaynaklı taleple özel sektör yatırımlarının hızlanmasını öngörüyoruz." dedi.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:43:"https://picsum.photos/seed/3930319/1200/800";s:6:"author";s:15:"Anadolu Ajansı";s:11:"publishedAt";s:25:"2026-05-07T14:21:14+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:12:"rss-aa-genel";s:10:"sourceName";s:15:"Anadolu Ajansı";s:9:"sourceUrl";s:168:"https://www.aa.com.tr/tr/bilim-teknoloji/cumhurbaskani-yardimcisi-yilmaz-kamuda-bulut-bilisim-ve-yapay-zeka-kullaniminda-yatirimlarinin-hizlanmasini-ongoruyoruz/3930319";}i:19;a:13:{s:2:"id";s:45:"rss-aa-genel-edd76a3fa83e4d990be632793190052f";s:5:"title";s:122:"ASFAT Genel Müdürü İlbaş: Savunma sanayisi ihracatçıları içerisinde ASFAT deniz tarafında ihracat birincisi oldu";s:7:"summary";s:258:"Milli Savunma Bakanlığına bağlı Askeri Fabrika ve Tersane İşletme Anonim Şirketi (ASFAT) Genel Müdürü Mustafa İlbaş, 2025 yılında savunma sanayisi ihracatçıları arasında şirketlerinin deniz tarafında ihracat birincisi olduğunu bildirdi.";s:7:"content";s:258:"Milli Savunma Bakanlığına bağlı Askeri Fabrika ve Tersane İşletme Anonim Şirketi (ASFAT) Genel Müdürü Mustafa İlbaş, 2025 yılında savunma sanayisi ihracatçıları arasında şirketlerinin deniz tarafında ihracat birincisi olduğunu bildirdi.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:43:"https://picsum.photos/seed/3930282/1200/800";s:6:"author";s:15:"Anadolu Ajansı";s:11:"publishedAt";s:25:"2026-05-07T13:58:31+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:12:"rss-aa-genel";s:10:"sourceName";s:15:"Anadolu Ajansı";s:9:"sourceUrl";s:152:"https://www.aa.com.tr/tr/ekonomi/asfat-genel-muduru-ilbas-savunma-sanayisi-ihracatcilari-icerisinde-asfat-deniz-tarafinda-ihracat-birincisi-oldu/3930282";}i:20;a:13:{s:2:"id";s:45:"rss-aa-genel-9af2231373fa3c35ab7dd86068959de1";s:5:"title";s:94:"Fransız amiral gemisi Charles de Gaulle'ün Kızıldeniz'e konuşlandırıldığı bildirildi";s:7:"summary";s:142:"Fransa Savunma Bakanlığı, Doğu Akdeniz'de bulunan Fransız uçak gemisi Charles de Gaulle'ün Kızıldeniz'e gönderildiğini açıkladı.";s:7:"content";s:142:"Fransa Savunma Bakanlığı, Doğu Akdeniz'de bulunan Fransız uçak gemisi Charles de Gaulle'ün Kızıldeniz'e gönderildiğini açıkladı.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:43:"https://picsum.photos/seed/3930341/1200/800";s:6:"author";s:15:"Anadolu Ajansı";s:11:"publishedAt";s:25:"2026-05-07T14:40:36+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:12:"rss-aa-genel";s:10:"sourceName";s:15:"Anadolu Ajansı";s:9:"sourceUrl";s:121:"https://www.aa.com.tr/tr/dunya/fransiz-amiral-gemisi-charles-de-gaulleun-kizildenize-konuslandirildigi-bildirildi/3930341";}i:21;a:13:{s:2:"id";s:45:"rss-aa-genel-7463b8b823cc9dd0d5402b51d42203bf";s:5:"title";s:35:"60 saniyede bugün (07 Mayıs 2026)";s:7:"summary";s:77:"Türkiye ve dünya gündeminin 60 saniyelik özeti. AJet'in katkılarıyla...";s:7:"content";s:77:"Türkiye ve dünya gündeminin 60 saniyelik özeti. AJet'in katkılarıyla...";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:43:"https://picsum.photos/seed/3930215/1200/800";s:6:"autho