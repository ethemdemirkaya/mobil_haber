a:2:{s:7:"expires";i:1778169909;s:5:"value";a:50:{i:0;a:13:{s:2:"id";s:46:"rss-trt-haber-6760dae1949bfa21b5e82901d29b6111";s:5:"title";s:62:""Gazze Mektupları Deneyim Sergisi" ziyaretçilerle buluşuyor";s:7:"summary";s:237:"İletişim Başkanlığı ve Okçular Vakfı destekleriyle hayata geçirilen "Gazze Mektupları" projesi, çağdaş teknolojiyi insani bir anlatıyla buluşturarak dikkat çeken yenilikçi bir deneyim sergisi olarak kapılarını açtı.";s:7:"content";s:237:"İletişim Başkanlığı ve Okçular Vakfı destekleriyle hayata geçirilen "Gazze Mektupları" projesi, çağdaş teknolojiyi insani bir anlatıyla buluşturarak dikkat çeken yenilikçi bir deneyim sergisi olarak kapılarını açtı.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:156:"https://picsum.photos/seed/https%3A%2F%2Fwww.trthaber.com%2Fhaber%2Fturkiye%2Fgazze-mektuplari-deneyim-sergisi-ziyaretcilerle-bulusuyor-944371.html/1200/800";s:6:"author";s:9:"TRT Haber";s:11:"publishedAt";s:25:"2026-05-07T15:20:00+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:13:"rss-trt-haber";s:10:"sourceName";s:9:"TRT Haber";s:9:"sourceUrl";s:108:"https://www.trthaber.com/haber/turkiye/gazze-mektuplari-deneyim-sergisi-ziyaretcilerle-bulusuyor-944371.html";}i:1;a:13:{s:2:"id";s:46:"rss-trt-haber-f7496a9c8828e876c693f4bf0c3bca64";s:5:"title";s:30:"Borsa İstanbul rekor tazeledi";s:7:"summary";s:85:"BIST 100 endeksi yüzde 0,82 artarak 15.040 puan ile günü rekor seviyeden kapattı.";s:7:"content";s:85:"BIST 100 endeksi yüzde 0,82 artarak 15.040 puan ile günü rekor seviyeden kapattı.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:128:"https://picsum.photos/seed/https%3A%2F%2Fwww.trthaber.com%2Fhaber%2Fekonomi%2Fborsa-istanbul-rekor-tazeledi-944370.html/1200/800";s:6:"author";s:9:"TRT Haber";s:11:"publishedAt";s:25:"2026-05-07T15:15:00+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:13:"rss-trt-haber";s:10:"sourceName";s:9:"TRT Haber";s:9:"sourceUrl";s:80:"https://www.trthaber.com/haber/ekonomi/borsa-istanbul-rekor-tazeledi-944370.html";}i:2;a:13:{s:2:"id";s:46:"rss-trt-haber-c9c6a0c1c4d9289a6be0d544715e4fbc";s:5:"title";s:80:"İmamoğlu çıkar amaçlı suç örgütü davasının 34. duruşması sona erdi";s:7:"summary";s:219:""İmamoğlu çıkar amaçlı suç örgütü"ne ilişkin 77'si tutuklu, 5'i müşteki sanık olmak üzere 414 sanığın yargılandığı davanın 34. duruşmasında, tutuklu sanık Mustafa Keleş'in savunması alındı.";s:7:"content";s:219:""İmamoğlu çıkar amaçlı suç örgütü"ne ilişkin 77'si tutuklu, 5'i müşteki sanık olmak üzere 414 sanığın yargılandığı davanın 34. duruşmasında, tutuklu sanık Mustafa Keleş'in savunması alındı.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:164:"https://picsum.photos/seed/https%3A%2F%2Fwww.trthaber.com%2Fhaber%2Fturkiye%2Fimamoglu-cikar-amacli-suc-orgutu-davasinin-34-durusmasi-sona-erdi-944369.html/1200/800";s:6:"author";s:9:"TRT Haber";s:11:"publishedAt";s:25:"2026-05-07T14:59:00+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:13:"rss-trt-haber";s:10:"sourceName";s:9:"TRT Haber";s:9:"sourceUrl";s:116:"https://www.trthaber.com/haber/turkiye/imamoglu-cikar-amacli-suc-orgutu-davasinin-34-durusmasi-sona-erdi-944369.html";}i:3;a:13:{s:2:"id";s:46:"rss-trt-haber-8cef15160dd9db320950c3ad0a8539fe";s:5:"title";s:81:"AB: İran krizi henüz turizm sektörü için kurtarma önlemlerini gerektirmiyor";s:7:"summary";s:238:"Avrupa Birliği, İran ile süregelen savaşın turizm ve havacılık sektöründeki etkilerinin henüz pandemi seviyesinde bir krize yol açmadığını belirterek, şirketlerin beklediği acil destek paketlerine yeşil ışık yakmadı.";s:7:"content";s:238:"Avrupa Birliği, İran ile süregelen savaşın turizm ve havacılık sektöründeki etkilerinin henüz pandemi seviyesinde bir krize yol açmadığını belirterek, şirketlerin beklediği acil destek paketlerine yeşil ışık yakmadı.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:171:"https://picsum.photos/seed/https%3A%2F%2Fwww.trthaber.com%2Fhaber%2Fdunya%2Fab-iran-krizi-henuz-turizm-sektoru-icin-kurtarma-onlemlerini-gerektirmiyor-944368.html/1200/800";s:6:"author";s:9:"TRT Haber";s:11:"publishedAt";s:25:"2026-05-07T14:46:00+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:13:"rss-trt-haber";s:10:"sourceName";s:9:"TRT Haber";s:9:"sourceUrl";s:123:"https://www.trthaber.com/haber/dunya/ab-iran-krizi-henuz-turizm-sektoru-icin-kurtarma-onlemlerini-gerektirmiyor-944368.html";}i:4;a:13:{s:2:"id";s:46:"rss-trt-haber-a41431f594fe3b7d2ae66d02025d2b05";s:5:"title";s:64:"Reuters: BAE, Hürmüz Boğazı'ndan tankerleri gizlice geçirdi";s:7:"summary";s:192:"Reuters haber ajansı, "Ham petrol yüklü Birleşik Arap Emirlikleri tankerleri radarlarını kapattı, İran donanmasına görünmeden Hürmüz Boğazı'ndan geçti." iddiasını paylaştı.";s:7:"content";s:192:"Reuters haber ajansı, "Ham petrol yüklü Birleşik Arap Emirlikleri tankerleri radarlarını kapattı, İran donanmasına görünmeden Hürmüz Boğazı'ndan geçti." iddiasını paylaştı.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:153:"https://picsum.photos/seed/https%3A%2F%2Fwww.trthaber.com%2Fhaber%2Fdunya%2Freuters-bae-hurmuz-bogazindan-tankerleri-gizlice-gecirdi-944367.html/1200/800";s:6:"author";s:9:"TRT Haber";s:11:"publishedAt";s:25:"2026-05-07T14:02:00+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:13:"rss-trt-haber";s:10:"sourceName";s:9:"TRT Haber";s:9:"sourceUrl";s:105:"https://www.trthaber.com/haber/dunya/reuters-bae-hurmuz-bogazindan-tankerleri-gizlice-gecirdi-944367.html";}i:5;a:13:{s:2:"id";s:46:"rss-trt-haber-9a0722d5b6d331a6260cdde5fe234ebc";s:5:"title";s:55:"Baykar, SAHA 2026'da çok sayıda anlaşmaya imza attı";s:7:"summary";s:263:"Baykar, SAHA 2026 Uluslararası Savunma, Havacılık ve Uzay Sanayi Fuarı'nda birçok stratejik işbirliği anlaşması imzaladı. Baykar'ın anlaşma imzaladığı şirketler arasında MKE, Aksa İleri Kompozit, TEI, ASELSAN, ROKETSAN ve EDGE Group yer alıyor.";s:7:"content";s:263:"Baykar, SAHA 2026 Uluslararası Savunma, Havacılık ve Uzay Sanayi Fuarı'nda birçok stratejik işbirliği anlaşması imzaladı. Baykar'ın anlaşma imzaladığı şirketler arasında MKE, Aksa İleri Kompozit, TEI, ASELSAN, ROKETSAN ve EDGE Group yer alıyor.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:148:"https://picsum.photos/seed/https%3A%2F%2Fwww.trthaber.com%2Fhaber%2Fsavunma%2Fbaykar-saha-2026da-cok-sayida-anlasmaya-imza-atti-944366.html/1200/800";s:6:"author";s:9:"TRT Haber";s:11:"publishedAt";s:25:"2026-05-07T14:10:00+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:13:"rss-trt-haber";s:10:"sourceName";s:9:"TRT Haber";s:9:"sourceUrl";s:100:"https://www.trthaber.com/haber/savunma/baykar-saha-2026da-cok-sayida-anlasmaya-imza-atti-944366.html";}i:6;a:13:{s:2:"id";s:46:"rss-trt-haber-5ed361bfef147afca0263bb26acd9c74";s:5:"title";s:86:"Gazze'de, okul sırasında olması gereken çocuklar saatlerce su kuyruğunda bekliyor";s:7:"summary";s:260:"Soykırımcı İsrailin saldırıları ve ağır şartlar altında yaşam mücadelesi veren Gazze Şeridindeki çocuklar, okulda ders sıralarında olmaları gerekirken ailelerine bir bidon su götürebilmek için her gün saatlerce su kuyruklarında bekliyor.";s:7:"content";s:260:"Soykırımcı İsrailin saldırıları ve ağır şartlar altında yaşam mücadelesi veren Gazze Şeridindeki çocuklar, okulda ders sıralarında olmaları gerekirken ailelerine bir bidon su götürebilmek için her gün saatlerce su kuyruklarında bekliyor.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:176:"https://picsum.photos/seed/https%3A%2F%2Fwww.trthaber.com%2Fhaber%2Fdunya%2Fgazzede-okul-sirasinda-olmasi-gereken-cocuklar-saatlerce-su-kuyrugunda-bekliyor-944365.html/1200/800";s:6:"author";s:9:"TRT Haber";s:11:"publishedAt";s:25:"2026-05-07T14:11:00+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:13:"rss-trt-haber";s:10:"sourceName";s:9:"TRT Haber";s:9:"sourceUrl";s:128:"https://www.trthaber.com/haber/dunya/gazzede-okul-sirasinda-olmasi-gereken-cocuklar-saatlerce-su-kuyrugunda-bekliyor-944365.html";}i:7;a:13:{s:2:"id";s:46:"rss-trt-haber-d8257d4a220aaef920d7c8fd311397bb";s:5:"title";s:99:"Bakan Uraloğlu: Krizler, alternatifi olmayan her sistemin kırılgan olduğunu açıkça gösterdi";s:7:"summary";s:307:"Bakan Uraloğlu: Bugün temel bir soruyla karşı karşıyayız: Ulaştırma sistemlerinin sadece kapasitesini artırmakla mı yetineceğiz yoksa onları her koşulda çalışır, güvenilir ve sürdürülebilir hale mi getireceğiz? Son yıllarda yaşanan krizler, alternatifi olmayan her sistemin kırılg";s:7:"content";s:370:"Bakan Uraloğlu: Bugün temel bir soruyla karşı karşıyayız: Ulaştırma sistemlerinin sadece kapasitesini artırmakla mı yetineceğiz yoksa onları her koşulda çalışır, güvenilir ve sürdürülebilir hale mi getireceğiz? Son yıllarda yaşanan krizler, alternatifi olmayan her sistemin kırılgan olduğunu açıkça göstermiştir" açıklamasını yaptı.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:188:"https://picsum.photos/seed/https%3A%2F%2Fwww.trthaber.com%2Fhaber%2Fekonomi%2Fbakan-uraloglu-krizler-alternatifi-olmayan-her-sistemin-kirilgan-oldugunu-acikca-gosterdi-944364.html/1200/800";s:6:"author";s:9:"TRT Haber";s:11:"publishedAt";s:25:"2026-05-07T13:54:00+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:13:"rss-trt-haber";s:10:"sourceName";s:9:"TRT Haber";s:9:"sourceUrl";s:140:"https://www.trthaber.com/haber/ekonomi/bakan-uraloglu-krizler-alternatifi-olmayan-her-sistemin-kirilgan-oldugunu-acikca-gosterdi-944364.html";}i:8;a:13:{s:2:"id";s:46:"rss-trt-haber-a0e0016bdb7493e695affba980952b26";s:5:"title";s:68:"Borsa İstanbul'daki şirketlerin değeri 516 milyar dolara çıktı";s:7:"summary";s:179:"Hazine ve Maliye Bakanı Mehmet Şimşek, 27 Şubat'tan itibaren Borsa İstanbul'da tüm şirketlerin değerinin 425 milyar dolardan 516 milyar dolara çıktığını açıkladı.";s:7:"content";s:179:"Hazine ve Maliye Bakanı Mehmet Şimşek, 27 Şubat'tan itibaren Borsa İstanbul'da tüm şirketlerin değerinin 425 milyar dolardan 516 milyar dolara çıktığını açıkladı.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:160:"https://picsum.photos/seed/https%3A%2F%2Fwww.trthaber.com%2Fhaber%2Fekonomi%2Fborsa-istanbuldaki-sirketlerin-degeri-516-milyar-dolara-cikti-944363.html/1200/800";s:6:"author";s:9:"TRT Haber";s:11:"publishedAt";s:25:"2026-05-07T13:58:00+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:13:"rss-trt-haber";s:10:"sourceName";s:9:"TRT Haber";s:9:"sourceUrl";s:112:"https://www.trthaber.com/haber/ekonomi/borsa-istanbuldaki-sirketlerin-degeri-516-milyar-dolara-cikti-944363.html";}i:9;a:13:{s:2:"id";s:46:"rss-trt-haber-d8713f14686aaee1ee240fe2feb1c749";s:5:"title";s:61:"Yolcu gemisi MV Hondius'ta 5 hantavirüs vakası doğrulandı";s:7:"summary";s:235:"Dünya Sağlık Örgütü DSÖ Genel Direktörü Tedros Adhanom Ghebreyesus, Arjantin'den yola çıkan bir gemide bildirilen 8 vakadan 5'inin hantavirüs olduğunun doğrulandığını, diğer 3'ünde ise şüphe bulunduğunu belirtti.";s:7:"content";s:235:"Dünya Sağlık Örgütü DSÖ Genel Direktörü Tedros Adhanom Ghebreyesus, Arjantin'den yola çıkan bir gemide bildirilen 8 vakadan 5'inin hantavirüs olduğunun doğrulandığını, diğer 3'ünde ise şüphe bulunduğunu belirtti.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:153:"https://picsum.photos/seed/https%3A%2F%2Fwww.trthaber.com%2Fhaber%2Fdunya%2Fyolcu-gemisi-mv-hondiusta-5-hantavirus-vakasi-dogrulandi-944362.html/1200/800";s:6:"author";s:9:"TRT Haber";s:11:"publishedAt";s:25:"2026-05-07T13:37:00+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:13:"rss-trt-haber";s:10:"sourceName";s:9:"TRT Haber";s:9:"sourceUrl";s:105:"https://www.trthaber.com/haber/dunya/yolcu-gemisi-mv-hondiusta-5-hantavirus-vakasi-dogrulandi-944362.html";}i:10;a:13:{s:2:"id";s:46:"rss-trt-haber-98eedd137197fa3d08fe87b8d7cef6be";s:5:"title";s:67:"Akkuyu NGS'nin 2. güç ünitesi için işletmeye alma izni verildi";s:7:"summary";s:250:"Nükleer Düzenleme Kurumu NDK, Rusya Devlet Nükleer Enerji Kuruluşu Rosatom'un inşa ettiği Akkuyu Nükleer Güç Santrali'nin NGS 2. Güç Ünitesi'ni işletmeye alma çalışmalarına başlaması için Akkuyu Nükleer AŞ'ye gerekli izni verdi.";s:7:"content";s:250:"Nükleer Düzenleme Kurumu NDK, Rusya Devlet Nükleer Enerji Kuruluşu Rosatom'un inşa ettiği Akkuyu Nükleer Güç Santrali'nin NGS 2. Güç Ünitesi'ni işletmeye alma çalışmalarına başlaması için Akkuyu Nükleer AŞ'ye gerekli izni verdi.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:159:"https://picsum.photos/seed/https%3A%2F%2Fwww.trthaber.com%2Fhaber%2Fekonomi%2Fakkuyu-ngsnin-2-guc-unitesi-icin-isletmeye-alma-izni-verildi-944361.html/1200/800";s:6:"author";s:9:"TRT Haber";s:11:"publishedAt";s:25:"2026-05-07T13:44:00+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:13:"rss-trt-haber";s:10:"sourceName";s:9:"TRT Haber";s:9:"sourceUrl";s:111:"https://www.trthaber.com/haber/ekonomi/akkuyu-ngsnin-2-guc-unitesi-icin-isletmeye-alma-izni-verildi-944361.html";}i:11;a:13:{s:2:"id";s:46:"rss-trt-haber-ff73716682db2e6a0b628c1858433215";s:5:"title";s:70:"FPV dronlara karşı yeni savunma: OLAY Projesi için imzalar atıldı";s:7:"summary";s:238:"Cumhurbaşkanlığı Savunma Sanayii Başkanlığı SSB ile HAVELSAN Teknoloji Radar HTR arasında SAHA 2026'da Olay Tabanlı Görüntüleme Özellikli Okuma Devresi ve Görüntüleme Birimi OLAY Projesi'ne ilişkin sözleşme imzalandı.";s:7:"content";s:238:"Cumhurbaşkanlığı Savunma Sanayii Başkanlığı SSB ile HAVELSAN Teknoloji Radar HTR arasında SAHA 2026'da Olay Tabanlı Görüntüleme Özellikli Okuma Devresi ve Görüntüleme Birimi OLAY Projesi'ne ilişkin sözleşme imzalandı.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:163:"https://picsum.photos/seed/https%3A%2F%2Fwww.trthaber.com%2Fhaber%2Fsavunma%2Ffpv-dronlara-karsi-yeni-savunma-olay-projesi-icin-imzalar-atildi-944360.html/1200/800";s:6:"author";s:9:"TRT Haber";s:11:"publishedAt";s:25:"2026-05-07T13:41:00+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:13:"rss-trt-haber";s:10:"sourceName";s:9:"TRT Haber";s:9:"sourceUrl";s:115:"https://www.trthaber.com/haber/savunma/fpv-dronlara-karsi-yeni-savunma-olay-projesi-icin-imzalar-atildi-944360.html";}i:12;a:13:{s:2:"id";s:46:"rss-trt-haber-6496fa654f4128eb4cc377a6373da870";s:5:"title";s:89:"Milli Muharip Uçak projesinde yılda ilave 24 uçaklık yeni üretim alanı planlanıyor";s:7:"summary";s:312:"TUSAŞ, Milli Muharip Uçak projesinde yılda ilave 24 uçaklık yeni üretim alanı tasarlıyor. TUSAŞ Milli Muharip Uçak Genel Müdür Yardımcısı Zengin, "Yılda 6 ila 9 KAAN'ı çıkarabileceğimiz üretim ortamına ulaşmış durumdayız. 20 uçaklı sözleşmeyi dün imzaladık SSB ile hava kuvvetleri";s:7:"content";s:341:"TUSAŞ, Milli Muharip Uçak projesinde yılda ilave 24 uçaklık yeni üretim alanı tasarlıyor. TUSAŞ Milli Muharip Uçak Genel Müdür Yardımcısı Zengin, "Yılda 6 ila 9 KAAN'ı çıkarabileceğimiz üretim ortamına ulaşmış durumdayız. 20 uçaklı sözleşmeyi dün imzaladık SSB ile hava kuvvetlerine teslim etmek üzere" dedi.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:181:"https://picsum.photos/seed/https%3A%2F%2Fwww.trthaber.com%2Fhaber%2Fsavunma%2Fmilli-muharip-ucak-projesinde-yilda-ilave-24-ucaklik-yeni-uretim-alani-planlaniyor-944359.html/1200/800";s:6:"author";s:9:"TRT Haber";s:11:"publishedAt";s:25:"2026-05-07T13:33:00+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:13:"rss-trt-haber";s:10:"sourceName";s:9:"TRT Haber";s:9:"sourceUrl";s:133:"https://www.trthaber.com/haber/savunma/milli-muharip-ucak-projesinde-yilda-ilave-24-ucaklik-yeni-uretim-alani-planlaniyor-944359.html";}i:13;a:13:{s:2:"id";s:46:"rss-trt-haber-dd2931a9abb3afc60f219ad6c6c7a3e4";s:5:"title";s:58:"COP31 kapsamında çevre ve iklim medya turu düzenlenecek";s:7:"summary";s:203:"Cumhurbaşkanlığı İletişim Başkanlığı ile Çevre, Şehircilik ve İklim Değişikliği Bakanlığı, 911 Mayıs'ta Hatay ve İstanbul'da kapsamlı bir "çevre ve iklim medya turu" düzenleyecek.";s:7:"content";s:203:"Cumhurbaşkanlığı İletişim Başkanlığı ile Çevre, Şehircilik ve İklim Değişikliği Bakanlığı, 911 Mayıs'ta Hatay ve İstanbul'da kapsamlı bir "çevre ve iklim medya turu" düzenleyecek.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:153:"h