a:2:{s:7:"expires";i:1778169911;s:5:"value";a:20:{i:0;a:13:{s:2:"id";s:47:"rss-ntv-gundem-ff91713fabc7bcbb545b7f55ae7bb079";s:5:"title";s:87:"Hantavirüs paniği | Üç kişinin öldüğü gemideki Türk yolcu son durumu anlattı";s:7:"summary";s:174:"Üç yolcunun hantavirüs nedeniyle yaşamını yitirdiği kruvaziyerin yolcuları arasında bir Türk de var. Yolculardan Emin Yoğurtçuoğlu, gemideki son durumu anlattı.";s:7:"content";s:174:"Üç yolcunun hantavirüs nedeniyle yaşamını yitirdiği kruvaziyerin yolcuları arasında bir Türk de var. Yolculardan Emin Yoğurtçuoğlu, gemideki son durumu anlattı.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:166:"https://picsum.photos/seed/https%3A%2F%2Fwww.ntv.com.tr%2Fturkiye%2Fgaleri-hantavirus-panigi-uc-kisinin-oldugu-gemideki-turk-yolcu-son-durumu-anlatti-1723301/1200/800";s:6:"author";s:3:"NTV";s:11:"publishedAt";s:25:"2026-05-07T15:32:22+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:14:"rss-ntv-gundem";s:10:"sourceName";s:15:"NTV — Gündem";s:9:"sourceUrl";s:120:"https://www.ntv.com.tr/turkiye/galeri-hantavirus-panigi-uc-kisinin-oldugu-gemideki-turk-yolcu-son-durumu-anlatti-1723301";}i:1;a:13:{s:2:"id";s:47:"rss-ntv-gundem-415bf3c48bf779c838bd31937dafaf5a";s:5:"title";s:94:"Cezayir Cumhurbaşkanı Tebbun Ankara'da. Cumhurbaşkanı Erdoğan resmi törenle karşıladı";s:7:"summary";s:122:"Cumhurbaşkanı Recep Tayyip Erdoğan, Cezayirli mevkidaşı Abdülmecid Tebbun'u Beştepe'de resmi törenle karşıladı.";s:7:"content";s:122:"Cumhurbaşkanı Recep Tayyip Erdoğan, Cezayirli mevkidaşı Abdülmecid Tebbun'u Beştepe'de resmi törenle karşıladı.";s:10:"categoryId";s:6:"gundem";s:8:"imageUrl";s:168:"https://picsum.photos/seed/https%3A%2F%2Fwww.ntv.com.tr%2Fturkiye%2Fcezayir-cumhurbaskani-tebbun-ankarada-cumhurbaskani-erdogan-resmi-torenle-karsiladi-1723293/1200/800";s:6:"author";s:3:"NTV";s:11:"publishedAt";s:25:"2026-05-07T13:50:32+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:14:"rss-ntv-gundem";s:10:"sourceName";s:15:"NTV —