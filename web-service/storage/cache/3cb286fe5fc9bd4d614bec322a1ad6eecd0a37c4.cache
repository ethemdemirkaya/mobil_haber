le";s:62:"Gazze'de hayati öneme sahip ilaçların yüzde 47'si tükendi";s:7:"summary";s:208:"İsrail'in ateşkese rağmen saldırılarını sürdürdüğü ve insani yardım ile ilaç girişini kısıtladığı Gazze Şeridi'nde, hayati öneme sahip ilaçların yüzde 47'sinin tükendiği bildirildi.";s:7:"content";s:208:"İsrail'in ateşkese rağmen saldırılarını sürdürdüğü ve insani yardım ile ilaç girişini kısıtladığı Gazze Şeridi'nde, hayati öneme sahip ilaçların yüzde 47'sinin tükendiği bildirildi.";s:10:"categoryId";s:5:"dunya";s:8:"imageUrl";s:43:"https://picsum.photos/seed/3929916/1200/800";s:6:"author";s:13:"AA — Dünya";s:11:"publishedAt";s:25:"2026-05-07T09:18:08+00:00";s:11:"readMinutes";i:1;s:10:"isFeatured";b:0;s:6:"source";s:12:"rss-aa-dunya";s:10:"sourceName";s:13:"AA — Dünya";s:9:"sourceUrl";s:94:"https://www.aa.com.tr/tr/dunya/gazzede-hayati-oneme-sahip-ilaclarin-yuzde-47si-tukendi/3929916";}}}